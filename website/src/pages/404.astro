---
import SiteLayout from "../layouts/SiteLayout.astro";
import PageHeading from "../components/PageHeading.astro";
import Button from "../components/Button.astro";
import { url } from "../config/site";
import { notFound } from "../config/pages/notFound";
---
<SiteLayout title={notFound.title} noindex>
  <PageHeading title={notFound.heading} lede={notFound.lede}>
    <Button href={url()} variant="primary">{notFound.homeLabel}</Button>
    <Button href={url("docs/")} variant="text">{notFound.docsLabel}</Button>
  </PageHeading>
</SiteLayout>
