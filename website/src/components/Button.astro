---
interface Props {
  href?: string;
  variant?: "primary" | "secondary" | "text";
  type?: "button" | "submit";
  disabled?: boolean;
  class?: string;
  [key: string]: unknown;
}
const { href, variant = "primary", type = "button", disabled = false, class: className, ...rest } = Astro.props;
---
{href ? (
  <a href={href} class:list={["btn", variant, className]} {...rest}><slot /></a>
) : (
  <button type={type} disabled={disabled} class:list={["btn", variant, className]} {...rest}><slot /></button>
)}
<style>
  .btn { display: inline-flex; align-items: center; justify-content: center; gap: var(--space-2); font: inherit; font-weight: 600; cursor: pointer; border-radius: var(--radius); }
  .primary, .secondary { min-height: 44px; padding: var(--space-2) var(--space-4); text-decoration: none; border: var(--line-width) solid var(--accent); }
  .primary { background: var(--accent); color: var(--accent-ink); }
  .primary:hover { background: var(--accent); color: var(--accent-ink); text-decoration: underline; }
  .secondary { background: transparent; color: var(--text); border-color: var(--line); }
  .secondary:hover { background: var(--hover); color: var(--text); border-color: var(--accent); }
  .text { background: none; border: 0; padding: 0; color: var(--text); text-decoration: underline; text-decoration-color: var(--accent); text-underline-offset: 0.2em; }
  .text:hover { color: var(--accent); }
  .btn:disabled, .btn[aria-disabled="true"] { opacity: 0.6; cursor: not-allowed; }
</style>
