---
interface Props { title: string; id?: string; level?: 2 | 3; }
const { title, id, level = 2 } = Astro.props;
const Tag = level === 3 ? "h3" : "h2";
---
<div class="section-heading">
  <Tag id={id}>{title}</Tag>
  <slot />
</div>
<style>
  .section-heading { margin-bottom: var(--space-6); max-width: var(--measure); }
  h2, h3 { margin: 0 0 var(--space-3); }
  h2 { font-size: var(--step-3); }
  h3 { font-size: var(--step-2); }
  .section-heading :global(p) { margin: 0; }
</style>
