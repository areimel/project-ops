---
interface Props { as?: "div" | "section" | "article" | "aside"; class?: string; }
const { as: Tag = "div", class: className } = Astro.props;
---
<Tag class:list={["card", className]}><slot /></Tag>
<style>
  .card { background: var(--surface); border: var(--line-width) solid var(--line); border-radius: var(--radius); padding: var(--space-5); }
  @media (max-width: 760px) { .card { padding: var(--space-4); } }
</style>
