{
  "name": "project-ops",
  "productName": "Project Ops",
  "version": "0.1.0",
  "description": "Find, filter and open your coding projects.",
  "main": "dist-electron/main.js",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "build:electron": "node scripts/build-electron.mjs",
    "build": "pnpm typecheck && vite build --configLoader runner && pnpm build:electron",
    "test": "vitest run --configLoader runner",
    "build:release": "pnpm typecheck && vite build --configLoader runner --mode release && pnpm build:electron && node scripts/check-release.mjs",
    "dist": "pnpm build:release && electron-builder --linux deb --x64",
    "dist:win": "pnpm build:release && electron-builder --win nsis --x64",
    "dist:mac": "pnpm build:release && electron-builder --mac dmg"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.3.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wait-on": "^9.5.1"
  },
  "author": "Alec Reimel",
  "homepage": "https://example.com/",
  "repository": {
    "type": "git",
    "url": "https://github.com/areimel/project-ops.git"
  },
  "packageManager": "pnpm@11.22.0",
  "desktopName": "project-ops.desktop"
}
